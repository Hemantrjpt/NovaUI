    -- ── compatibility shims (Obsidian-style API over MacUI) ────────────
    local C = {}
    local proxyMT = {}
    proxyMT.__index = function(self, k)
        if k == "Value" then return self.ctrl:GetValue() end
        if k == "OnChanged" then
            return function(_, handler) self.handler = handler end
        end
        if k == "SetValues" then
            return function(_, list) self.ctrl:SetOptions(list, true) end
        end
        local m = self.ctrl[k]
        if type(m) == "function" then
            return function(_, ...) return m(self.ctrl, ...) end
        end
        return m
    end
    local function register(id, ctrl)
        local entry = setmetatable({ ctrl = ctrl }, proxyMT)
        C[id] = entry
        return entry
    end
    options = setmetatable({}, { __index = function(_, k) return C[k] end })
    toggles = setmetatable({}, { __index = function(_, k) return C[k] end })

    local function fireCallback(id, extra)
        return function(value)
            local e = C[id]
            if e and e.handler then pcall(e.handler, value) end
            if extra then pcall(extra, value) end
        end
    end

