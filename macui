    local function crateOpenOne(variantName)
        local ok, result = pcall(function()
            return get:InvokeServer("S_Inventory", "Crate", variantName)
        end)
        if not ok then return nil end
        return result
    end
    local function runCrateLoop(limit)
        crateState.running = true
        crateState.stopFlag = false
        local list = crateSelectedList()
        if #list == 0 then
            crateLog("No crates selected")
            crateState.running = false
            return 0
        end
        local total = 0
        for _, cat in ipairs(list) do
            if crateState.stopFlag then break end
            local variants = CRATE_VARIANTS[cat] or { cat }
            for _, variant in ipairs(variants) do
                if crateState.stopFlag then break end
                local opened = 0
                local cap = limit or 500
                while opened < cap do
                    if crateState.stopFlag then break end
                    local r = crateOpenOne(variant)
                    if r == nil then break end
                    opened += 1; total += 1
                    bumpStat("CratesOpened", 1)
                    refreshStatLabels()
                    crateLog(string.format("%s #%d (total %d)", variant, opened, total))
                    if limit and opened >= limit then break end
                    task.wait(0.35)
                end
            end
        end
        crateState.running = false
        return total
    end

