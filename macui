        local function cdhwNextSpear()
            local char = localPlayer.Character
            local rig = char
                and (char:FindFirstChild("Rig_" .. localPlayer.Name) or char)
            if not rig then return nil end
            for _, armName in ipairs({ "LeftLowerArm", "RightLowerArm" }) do
                local arm = rig:FindFirstChild(armName)
                local holder = arm and arm:FindFirstChild("Spears")
                if holder then
                    for _, spear in ipairs(holder:GetChildren()) do
                        if spear:GetAttribute("Used") == nil then
                            return spear.Name
                        end
                    end
                end
            end
            return nil
        end

        local function cdhwTitanAlive(titan)
            if not titan or not titan.Parent then return false end
            if titan:GetAttribute("Killed") or titan:GetAttribute("Dead") then
                return false
            end
            local fake = titan:FindFirstChild("Fake")
            local head = fake and fake:FindFirstChild("Head")
            if head then return head.CanCollide == true end
            local hum = titan:FindFirstChildOfClass("Humanoid")
            return hum ~= nil and hum.Health > 0
        end

        local function cdhwLoop()
            task.spawn(function()
                while getgenv().AutoFarmRaids do
                    local ok, err = pcall(function()
                        if stallColossalTitan then
                            task.wait(1)
                            return
                        end
                        local character = localPlayer.Character
                        local root = character and character:FindFirstChild("HumanoidRootPart")
                        if not root then task.wait(1) return end

                        if cdhwAmmoOut() then
                            cdhwRefillTrip()
                            task.wait(0.2)
                            character = localPlayer.Character
                            root = character and character:FindFirstChild("HumanoidRootPart")
                            if not root then return end
                        end

                        local target, nape
                        local distance = math.huge
                        local titans = workspace:FindFirstChild("Titans")
                        for _, titan in ipairs(titans and titans:GetChildren() or {}) do
                            if titan:IsA("Model") then
                                local hitboxes = titan:FindFirstChild("Hitboxes")
                                local hit = hitboxes and hitboxes:FindFirstChild("Hit")
                                local neck = hit and hit:FindFirstChild("Nape")
                                    or titan:FindFirstChild("Nape", true)
                                if cdhwTitanAlive(titan) and neck and neck:IsA("BasePart") then
                                    local mag = (root.Position - neck.Position).Magnitude
                                    if mag < distance then
                                        distance, target, nape = mag, titan, neck
                                    end
                                end
                            end
                        end
                        if not target or not nape then task.wait(0.5) return end

                        while cdhwTitanAlive(target) and getgenv().AutoFarmRaids do
                            if getgenv().THUB_TripActive then
                                task.wait(0.5)
                                continue
                            end
                            character = localPlayer.Character
                            root = character and character:FindFirstChild("HumanoidRootPart")
                            if not root then break end
                            if not nape or not nape.Parent then
                                local hitboxes = target:FindFirstChild("Hitboxes")
                                local hit = hitboxes and hitboxes:FindFirstChild("Hit")
                                nape = hit and hit:FindFirstChild("Nape")
                            end
                            if not nape then break end
                            if target:GetAttribute("State") == "Berserk_Mode" then
                                task.wait(0.5)
                                continue
                            end
                            if cdhwAmmoOut() then
                                cdhwRefillTrip()
                                character = localPlayer.Character
                                root = character and character:FindFirstChild("HumanoidRootPart")
                                if not root then break end
                            end
                            pcall(function()
                                local swingTween = game:GetService("TweenService"):Create(
                                    root,
                                    TweenInfo.new(0.25, Enum.EasingStyle.Quad),
                                    { CFrame = nape.CFrame * CFrame.new(0, getgenv().CDHWHoverHeight or 20, 5) })
                                swingTween:Play()
                                local tweenStart = os.clock()
                                while swingTween.PlaybackState == Enum.PlaybackState.Playing
                                    and os.clock() - tweenStart < 1 do
                                    task.wait(0.05)
                                end
                                swingTween:Cancel()
                            end)
                            local weapon = localPlayer:GetAttribute("Weapon") or "Blades"
                            if weapon == "Spears" then
                                local spearName = cdhwNextSpear()
                                if spearName then
                                    get:InvokeServer("Spears", "S_Fire", spearName)
                                end
                                local explodeLoops = cdhwBossNames[target.Name] and 40 or 1
                                for _ = 1, explodeLoops do
                                    post:FireServer("Spears", "S_Explode", nape.Position, 0.05)
                                end
                            else
                                virtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                                task.wait(0.03)
                                virtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                                post:FireServer("Attacks", "Slash", true)
                                task.wait(0.04)
                                post:FireServer("Hitboxes", "Register", nape, math.random(620, 860))
                            end
                            if getgenv().CDHWMultiHit then
                                local maxExtra = getgenv().CDHWMultiHitAmount or 3
                                local hitRange = getgenv().CDHWMultiHitRange or 500
                                local extras = {}
                                for _, other in ipairs(titans and titans:GetChildren() or {}) do
                                    if other ~= target and other:IsA("Model") then
                                        local otherHit = other:FindFirstChild("Hitboxes")
                                        otherHit = otherHit and otherHit:FindFirstChild("Hit")
                                        local otherNape = otherHit
                                            and otherHit:FindFirstChild("Nape")
                                        if cdhwTitanAlive(other) and otherNape then
                                            local otherDist
                                                = (root.Position - otherNape.Position).Magnitude
                                            if otherDist <= hitRange then
                                                table.insert(extras, {
                                                    nape = otherNape,
                                                    dist = otherDist,
                                                })
                                            end
                                        end
                                    end
                                end
                                table.sort(extras, function(a, b)
                                    return a.dist < b.dist
                                end)
                                local registered = 1
                                for _, entry in ipairs(extras) do
                                    if registered >= maxExtra then break end
                                    if weapon == "Spears" then
                                        post:FireServer("Spears", "S_Explode", entry.nape.Position, 0.05)
                                    else
                                        post:FireServer("Hitboxes", "Register", entry.nape, math.random(620, 860))
                                    end
                                    registered += 1
                                end
                            end
                            if weapon ~= "Spears" and cdhwBossNames[target.Name] then
                                for _ = 1, 40 do
                                    post:FireServer("Hitboxes", "Register", nape, math.random(620, 860))
                                end
                            end
                            task.wait(0.15)
                            if not target.Parent then break end
                        end
                    end)
                    if not ok then warn("[Farm] " .. tostring(err)) end
                    task.wait()
                end
            end)
        end
