            pcall(function()
                local data = get:InvokeServer("Data", "Copy")
                if type(data) ~= "table" or not data.Slots then return end
                local slotName = data.Current_Slot or localPlayer:GetAttribute("Slot") or "A"
                local slot = data.Slots[slotName]
                local level, prestige, gold, gems = "?", "?", "?", "?"
                if slot then
                    if slot.Progression then
                        if slot.Progression.Level ~= nil then level = tostring(slot.Progression.Level) end
                        if slot.Progression.Prestige ~= nil then prestige = tostring(slot.Progression.Prestige) end
                    end
                    if slot.Currency then
                        if slot.Currency.Gold ~= nil then gold = tostring(slot.Currency.Gold) end
                        if slot.Currency.Gems ~= nil then gems = tostring(slot.Currency.Gems) end
                    end
                end
                local lifetimeKills = "?"
                if data.Statistics and data.Statistics.Titan_Kills
                    and data.Statistics.Titan_Kills.Total then
                    lifetimeKills = tostring(data.Statistics.Titan_Kills.Total)
                end
                pcall(function() metaLabels[1]:SetText("Level: " .. level) end)
                pcall(function() metaLabels[2]:SetText("Prestige: " .. prestige) end)
                pcall(function() metaLabels[3]:SetText("Lifetime Kills: " .. lifetimeKills) end)
                pcall(function() metaLabels[4]:SetText("Gold: " .. gold) end)
                pcall(function() metaLabels[5]:SetText("Gems: " .. gems) end)
            end)
        end

        local runLabels = {
            addLabel(StatsRun, "Kills: —"),
            addLabel(StatsRun, "Damage: —"),
            addLabel(StatsRun, "Crits: —"),
            addLabel(StatsRun, "Time Taken: —"),
            addLabel(StatsRun, "Drops: —"),
            addLabel(StatsRun, "Perks: —"),
        }
        local function runRowText(holder, rowName)
            local row = holder and holder:FindFirstChild(rowName)
            local amount = row and row:FindFirstChild("Amount")
            return (amount and amount:IsA("TextLabel")) and tostring(amount.Text) or nil
        end
        readRunGUI = function()
            if not (rewards and rewards.Visible) then return nil end
            local main = rewards:FindFirstChild("Main")
            local info = main and main:FindFirstChild("Info")
            local inner = info and info:FindFirstChild("Main")
            if not inner then return nil end
            local statsHolder = inner:FindFirstChild("Stats")
            local run = {
                kills  = runRowText(statsHolder, "Kills") or "?",
                damage = runRowText(statsHolder, "Damage") or "?",
                crits  = runRowText(statsHolder, "Crits") or "?",
                time   = runRowText(statsHolder, "Time_Taken") or "?",
                drops = {}, perks = {},
            }
            local items2 = inner:FindFirstChild("Items")
            if items2 then
                for _, entry in ipairs(items2:GetChildren()) do
                    if entry:IsA("Frame") and entry:FindFirstChild("Main") then
                        local ins = entry.Main:FindFirstChild("Inner")
                        if ins then
                            local qty = ins:FindFirstChild("Quantity")
                            local qtyNum = (qty and qty:IsA("TextLabel"))
                                and tonumber(tostring(qty.Text):match("%d+")) or 1
                            local catId = tonumber(tostring(entry.Name):match("^(%d+)_")) or 1
                            local it = { name = tostring(entry.Name), count = qtyNum or 1 }
                            if catId == 2 then
                                run.perks[#run.perks + 1] = it
                            else
                                run.drops[#run.drops + 1] = it
                            end
                        end
                    end
                end
            end
            return run
        end
        setLastRun = function(run)
            if not run then return end
            pcall(function()
                runLabels[1]:SetText("Kills: " .. tostring(run.kills))
                runLabels[2]:SetText("Damage: " .. tostring(run.damage))
                runLabels[3]:SetText("Crits: " .. tostring(run.crits))
                runLabels[4]:SetText("Time Taken: " .. tostring(run.time))
                local dropLines, perkLines = {}, {}
                for _, d in ipairs(run.drops or {}) do
                    dropLines[#dropLines + 1] = string.format("• %s x%s", tostring(d.name), tostring(d.count or 1))
                end
                for _, p in ipairs(run.perks or {}) do
                    perkLines[#perkLines + 1] = string.format("★ %s x%s", tostring(p.name), tostring(p.count or 1))
                end
                runLabels[5]:SetText(#dropLines > 0
                    and ("Drops: " .. table.concat(dropLines, ", ")) or "Drops: none")
                runLabels[6]:SetText(#perkLines > 0
                    and ("Perks: " .. table.concat(perkLines, ", ")) or "Perks: none")
            end)
        end
    end

