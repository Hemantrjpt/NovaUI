    local RewardCapture = { get = nil, chest = nil, hooked = false }

    local PerkRarityOf = {}
    pcall(function()
        local PerksMod = require(v2.Modules.Storage.Perks)
        if type(PerksMod) == "table" then
            for tier, bucket in pairs(PerksMod) do
                if type(bucket) == "table" then
                    for name in pairs(bucket) do
                        PerkRarityOf[name] = tier
                    end
                end
            end
        end
    end)

    local function extractReward(kind, a)
        if type(a) ~= "table" then return nil end
        local o = { obtained = {}, perks = {}, drops = {}, completed = a.Completed }
        if kind == "Chest" then
            for _, item in ipairs(a) do
                if type(item) == "table" then
                    local nm = item.Real_Tag or item.Tag or item.Name
                    if nm ~= nil then o.drops[#o.drops + 1] = tostring(nm) end
                end
            end
            return o
        end
        local ob = a.Obtained
        if type(ob) ~= "table" then
            ob = a.Obtain or a.Rewards or a.Currency or a.Currencies or {}
        end
        if type(ob) == "table" then
            for k, v2x in pairs(ob) do
                local keyName = tostring(k)
                if keyName == "Perks" and type(v2x) == "table" then
                    for _, pn in ipairs(v2x) do o.perks[#o.perks + 1] = tostring(pn) end
                elseif keyName == "Drops" and type(v2x) == "table" then
                    for _, dn in ipairs(v2x) do o.drops[#o.drops + 1] = tostring(dn) end
                else
                    local num = type(v2x) == "number" and v2x or tonumber(tostring(v2x))
                    if num and num ~= 0 then
                        o.obtained[keyName] = num
                    end
                end
            end
        end
        local function collectList(src, into)
            if type(src) ~= "table" then return end
            for _, v2x in ipairs(src) do
                if type(v2x) == "table" then
                    local nm = v2x.Name or v2x.Real_Tag or v2x.Tag
                    if nm ~= nil then into[#into + 1] = tostring(nm) end
                else
                    into[#into + 1] = tostring(v2x)
                end
            end
        end
        collectList(a.Perks, o.perks)
        collectList(a.Drops, o.drops)
        collectList(a.Items, o.drops)
        return o
    end

    local function consumeRewardData(small)
        pcall(function()
            for key, amt in pairs(small.obtained or {}) do
                local lower = tostring(key):lower()
                if lower:find("gold", 1, true) then bumpStat("GoldCollected", amt)
                elseif lower == "xp" or lower == "exp" then bumpStat("ExpCollected", amt)
                elseif lower:find("gem", 1, true) then bumpStat("GemsCollected", amt)
                elseif lower:find("cane", 1, true) then bumpStat("CanesCollected", amt) end
            end
            for _, drop in ipairs(small.drops or {}) do
                local lower = tostring(drop):lower()
                if lower:find("serum", 1, true) then bumpStat("TitanSerums", 1)
                elseif lower:find("scroll", 1, true) then bumpStat("PrestigeScrolls", 1)
                elseif lower:find("shard", 1, true) then bumpStat("TitanShards", 1)
                else bumpStat("ItemDrops", 1) end
            end
            for _, perk in ipairs(small.perks or {}) do
                local tier = (PerkRarityOf[perk] or tostring(perk)):lower()
                if tier:find("epic", 1, true) then bumpStat("EpicPerksCollected", 1)
                elseif tier:find("legendary", 1, true) then bumpStat("LegendaryPerks", 1)
                elseif tier:find("mythic", 1, true) then bumpStat("MythicPerks", 1) end
            end
            refreshStatLabels()
        end)
    end

    if type(getrawmetatable) == "function" and type(setreadonly) == "function"
        and type(newcclosure) == "function" and type(getnamecallmethod) == "function" then
        pcall(function()
            local mt = getrawmetatable(game)
            local old = mt.__namecall
            if not old then return end
            setreadonly(mt, false)
            mt.__namecall = newcclosure(function(self, ...)
                local first, kind = ...
                local okM, method = pcall(getnamecallmethod)
                if okM and method == "InvokeServer"
                    and tostring(self) == "GET"
                    and first == "S_Rewards"
                    and (kind == "Get" or kind == "Chest") then
                    local a, b = old(self, ...)
                    pcall(function()
                        local small = extractReward(kind, a)
                        if small then
                            if kind == "Chest" then
                                RewardCapture.chest = small
                                consumeRewardData(small)
                                RewardCapture.chest = nil
                            else
                                RewardCapture.get = small
                            end
                        end
                    end)
                    return a, b
                end
                return old(self, ...)
            end)
            setreadonly(mt, true)
            RewardCapture.hooked = true
        end)
    end

