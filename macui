                -- Secondary: a "Retry" button is only present on a
                -- failed run — its presence is a strong signal.
                local buttons = inner:FindFirstChild("Buttons")
                local retry = buttons and buttons:FindFirstChild("Retry")
                if retry and retry.Visible then
                    isFailed = true
                end
            end)

            if isFailed then
