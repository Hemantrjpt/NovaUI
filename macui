    local function currentFamilyName()
        local last = getgenv().AOTR_LastFamily
        if last and last.name then return last.name, last.rarity end
        local ok, shown = pcall(function()
            return tostring(playerGui.Interface.Customisation.Family.Family.Title.Text)
        end)
        if not ok or not shown or shown == "" then return nil end
        shown = shown:match("^(.-)%s*%b()$") or shown:match("^(%S+)") or shown
        for n, r in pairs(Family.nameRarity) do
            if n:upper() == shown:upper() then return n, r end
        end
        return shown, nil
    end

    local function matchesStop(name, rarity)
        local mode = options.RollStopMode and options.RollStopMode.Value or "Rarity"
        local rank = RANK[rarity or ""] or 0
        if mode ~= "Names" then
            local target = RANK[options.RollStopRarity.Value] or 99
            if toggles.RollExactRarity and toggles.RollExactRarity.Value then
                if rank == target and rank > 0 then return true end
            elseif rank >= target then
                return true
            end
        end
        if mode ~= "Rarity" then
            local selected = options.RollStopFamilies and options.RollStopFamilies.Value or {}
            for label in pairs(toSet(selected)) do
                if Family.labelName[label] == name then
                    return true
                end
            end
        end
        return false
    end

    local function rollCurrency()
        local c = options.RollCurrency and options.RollCurrency.Value or "Normal"
        return c == "Lucky" and "Lucky" or "Normal"
    end

    local function rollOnce()
        local cur = rollCurrency()
        local ok, ledger, assigned, pity, list = pcall(get.InvokeServer, get, "Family", "Roll", cur)
        if not ok or type(ledger) ~= "table" then
            return nil
        end

        local slot = ledger[cur] or ledger
        local left
        if type(slot) == "table" then
            left = (tonumber(slot.Amount) or 0) + (tonumber(slot.Free) or 0)
        else
            left = (tonumber(slot) or 0)
        end
        Family.spins = left
        Family.pity = pity

        local bestEntry = nil
        if type(list) == "table" then
            for _, r in ipairs(list) do
                if type(r) == "table" and r.Rarity then
                    if not bestEntry or (RANK[r.Rarity] or 0) > (RANK[bestEntry.Rarity or ""] or 0) then
                        bestEntry = r
                    end
                end
            end
        end
        if not bestEntry and type(assigned) == "string" and assigned ~= "" then
            bestEntry = { Family = assigned }
        end
        if not bestEntry or not bestEntry.Family then
            return nil
        end

        local rarity = bestEntry.Rarity or Family.nameRarity[bestEntry.Family] or "Common"
        return {
            family = bestEntry.Family,
            rarity = rarity,
            left = left,
            pity = Family.pity,
        }
    end

    local function storeCurrent()
        local ok, success, storedName, newCurrent = pcall(get.InvokeServer, get, "Family", "Store")
        if ok and success == true then
            getgenv().AOTR_LastFamily = { name = newCurrent or "?", rarity = newCurrent and Family.nameRarity[newCurrent] or "Common" }
            return true
        end
        return false
    end

    local function stopRoll(reason)
        if reason then
            notifyRoll(nil, reason)
        end
        getgenv().AutoFamilyRoll = false
        pcall(function() toggles.AutoSpinFamilyToggle:SetValue(false) end)
    end

    local function rollLoop()
        if Family.running then return end
        Family.running = true

        local curName, curRarity = currentFamilyName()
        if curName and matchesStop(curName, curRarity) then
            if toggles.StoreFamilyToggle.Value then
                local ok = storeCurrent()
                if ok then
                    Family.stored += 1
                    updateStatus()
                    notifyRoll("Stored", "Your current family (" .. curName .. ") already matched, stored it first.")
                else
                    Family.running = false
                    stopRoll("Current family (" .. curName .. ") already matched but storing failed (storage full?). Not rolling.")
                    return
                end
            else
                Family.running = false
                stopRoll("Current family (" .. curName .. ") already matches the stop condition. Enable Auto Store or change the condition.")
                return
            end
        end

        local fails, extraDelay = 0, 0
        while Family.alive and toggles.AutoSpinFamilyToggle.Value do
            local maxRolls = options.RollMaxSlider.Value
            if maxRolls > 0 and Family.rolls >= maxRolls then
                stopRoll("Reached max rolls (" .. maxRolls .. ").")
                break
            end

            local res = rollOnce()
            if not res then
                fails += 1
                if fails >= 5 then
                    stopRoll("Server kept rejecting rolls (cooldown or no spins left).")
                    break
                end
                extraDelay = math.min(extraDelay + 0.5, 4)
            else
                fails, extraDelay = 0, 0
                Family.rolls += 1
                Family.spins = res.left
                Family.pity = res.pity
                Family.last = res.family .. " (" .. res.rarity .. ")"
                getgenv().AOTR_LastFamily = { name = res.family, rarity = res.rarity }
                updateStatus()

                if (res.left or 0) <= 0 then
                    stopRoll("Out of " .. rollCurrency() .. " spins.")
                    break
                end

                if matchesStop(res.family, res.rarity) then
                    local kept = false
                    if toggles.StoreFamilyToggle.Value then
                        if storeCurrent() then
                            kept = true
                            Family.stored += 1
                            notifyRoll("Stored", string.format("%s (%s) after %d rolls.",
                                res.family, res.rarity, Family.rolls))
                        else
                            notifyRoll("Store failed",
                                res.family .. " is equipped but couldn't be stored (storage full?).")
                        end
                    else
                        notifyRoll("Hit!", res.family .. " (" .. res.rarity .. ") is equipped. Auto Store is off.")
                    end
                    sendWebhook(res.family, res.rarity)
                    updateStatus()
                    if not (kept and toggles.RollKeepGoingToggle.Value) then
                        stopRoll()
                        break
                    end
                end
            end

            task.wait(options.RollDelaySlider.Value + extraDelay)
        end

        Family.running = false
        if Family.alive and toggles.AutoSpinFamilyToggle.Value then
            pcall(function() toggles.AutoSpinFamilyToggle:SetValue(false) end)
        end
    end

