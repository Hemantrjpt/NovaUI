    --  COSMETICS — client-side accessory wear
    -- ═══════════════════════════════════════════════════════════════════
    local function buildCosmeticsTab()
        local CosmeticDef, AccessoryFolder, ANIM_PREFIX, CLONE_PREFIX
        ANIM_PREFIX, CLONE_PREFIX = "rbxassetid://", "CS_"

        local okCosmetic = pcall(function()
            local util = v2.Modules:FindFirstChild("Utilities")
            local module = util and util:FindFirstChild("Cosmetic")
            if module then CosmeticDef = require(module) end
        end)
        local assets = v2:FindFirstChild("Assets")
        local customisation = assets and assets:FindFirstChild("Customisation")
        AccessoryFolder = customisation and customisation:FindFirstChild("Accessory")

        if not CosmeticDef or not AccessoryFolder or not CosmeticDef.Accessories then
            pcall(function()
                lib:Notify({ Title = "Cosmetics",
                    Description = "Cosmetic data not found in this place.", Time = 5 })
            end)
        else
            local worn = {}
            local cosmAlive = true

            local RARITY_ORDER = { "Exclusive", "Mythic", "Legendary", "Epic", "Rare", "Uncommon", "Common" }
            local RANK2 = {}
            for i, r in ipairs(RARITY_ORDER) do RANK2[r] = i end

            local entries = {}
            for _, m in ipairs(AccessoryFolder:GetChildren()) do
                local def = CosmeticDef.Accessories[m.Name]
                if def and not def.Rig and m.Name ~= "1" then
                    local item = Items and Items[m.Name]
                    local rarity = (item and item.Rarity) or "Common"
                    table.insert(entries, {
                        name = m.Name, rarity = rarity,
                        label = m.Name .. " [" .. rarity .. "]",
                    })
                end
            end
            table.sort(entries, function(a, b)
                if a.rarity ~= b.rarity then
                    return (RANK2[a.rarity] or 99) < (RANK2[b.rarity] or 99)
                end
                return a.name < b.name
            end)

            local labels, nameFromLabel = {}, {}
            for _, e in ipairs(entries) do
                table.insert(labels, e.label)
                nameFromLabel[e.label] = e.name
            end

            local function prepParts(model)
                for _, d in ipairs(model:GetDescendants()) do
                    if d:IsA("BasePart") then
                        d.Anchored = false
                        d.CanCollide = false
                        d.CanTouch = false
                        d.Massless = true
                    end
                end
            end

            local function attach(char, name)
                local def = CosmeticDef.Accessories[name]
                local src = AccessoryFolder:FindFirstChild(name)
                if not (def and src) or def.Rig then return nil end

                local model = src:Clone()
                model.Name = CLONE_PREFIX .. name
                prepParts(model)

                local k = def.Resize and 0.92 or 1
                local offset = CFrame.new(def.Position.X * k, def.Position.Y * k, def.Position.Z * k) * def.Angle

                if def.Part then
                    local anchor = char:FindFirstChild(def.Part)
                    local primary = model.PrimaryPart
                    if not (anchor and primary) then
                        model:Destroy()
                        return nil
                    end
                    local weld = Instance.new("Weld")
                    weld.Name = "W"
                    weld.Part0 = anchor
                    weld.Part1 = primary
                    weld.C1 = offset
                    weld.Parent = primary

                    if name == "Berserker's Mane" then
                        local cloak = model:FindFirstChild("Mane Cloak")
                        for _, armName in ipairs({ "LeftUpperArm", "RightUpperArm" }) do
                            local arm = char:FindFirstChild(armName)
                            local piece = cloak and cloak:FindFirstChild(armName .. "b")
                            local w = piece and piece:FindFirstChild("W")
                            if arm and w then w.Part0 = arm end
                        end
                    end
                else
                    for _, sub in ipairs(model:GetChildren()) do
                        if sub:IsA("Model") and sub.PrimaryPart then
                            local target = char:FindFirstChild(sub.Name)
                            if target then
                                local primary = sub.PrimaryPart
                                local weld = Instance.new("Weld")
                                weld.Name = "W"
                                weld.Part0 = target
                                weld.Part1 = primary
                                weld.C1 = primary:GetAttribute("C1") or offset
                                weld.Parent = primary
                            end
                        end
                    end
                end

                model.Parent = char

                local animId = CosmeticDef.Animations and CosmeticDef.Animations[name]
                local controller = model:FindFirstChild("Controller", true)
                local animator = controller and controller:FindFirstChildOfClass("Animator")
                if animId and animator then
                    pcall(function()
                        local anim = Instance.new("Animation")
                        anim.AnimationId = ANIM_PREFIX .. animId
                        animator:LoadAnimation(anim):Play()
                    end)
                end
                return model
            end

            local function removeWorn(name)
                local m = worn[name]
                worn[name] = nil
                if m then m:Destroy() end
            end

            local function selectedSet()
                local set = {}
                for label in pairs(toSet(options.CosmeticsDropdown.Value)) do
                    if nameFromLabel[label] then set[nameFromLabel[label]] = true end
                end
                return set
            end

            local function sync()
                local want = selectedSet()
                for name in pairs(worn) do
                    if not want[name] then removeWorn(name) end
                end
                local char = localPlayer.Character
                if not char then return end
                for name in pairs(want) do
                    local m = worn[name]
                    if not m or m.Parent ~= char then
                        if m then m:Destroy() end
                        worn[name] = attach(char, name)
                    end
                end
            end

            local CosmWear = group(tbl7.Cosmetics, "Wear", "shirt")
            local CosmInfo = group(tbl7.Cosmetics, "Info", "info")

            addDropdown(CosmWear, "CosmeticsDropdown", {
                Text = "Cosmetics",
                Values = labels,
                Multi = true,
                Searchable = true,
                Tooltip = "Tick as many as you like, they appear instantly (client-side only)",
                Callback = function() pcall(sync) end,
            })

            addToggle(CosmWear, "CosmeticsReapplyToggle", {
                Text = "Re-apply after respawn",
                Default = true,
                Tooltip = "Puts them back if your character respawns or gets swapped",
            })

            addButton(CosmWear, {
                Text = "Remove All Cosmetics",
                Func = function()
                    options.CosmeticsDropdown:SetValue({})
                    pcall(sync)
                end,
            })

            addButton(CosmWear, {
                Text = "Wear Random Cosmetic",
                Func = function()
                    if #entries == 0 then return end
                    local e = entries[math.random(1, #entries)]
                    options.CosmeticsDropdown:SetValue({ e.label })
                    pcall(sync)
                    lib:Notify({ Title = "Cosmetics", Description = "Wearing " .. e.label, Time = 3 })
                end,
            })

            addLabel(CosmInfo, ("%d cosmetics available. Only you can see them — nothing is equipped on your account. They survive respawns."):format(#entries))

            task.spawn(function()
                while cosmAlive do
                    task.wait(1)
                    local reapply = toggles.CosmeticsReapplyToggle
                    if cosmAlive and reapply and reapply.Value then
                        pcall(sync)
                    end
                end
            end)

            getgenv().AOTR_CosmeticsCleanup = function()
                cosmAlive = false
                for name in pairs(worn) do removeWorn(name) end
            end
        end
    end
    buildCosmeticsTab()

