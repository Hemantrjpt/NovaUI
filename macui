    local function normalizeCrateSelection(sel)
        local out = {}
        if type(sel) == "table" then
            for _, v2x in ipairs(sel) do
                if type(v2x) == "string" and v2x ~= "" then out[v2x] = true end
            end
            for k, v2x in pairs(sel) do
                if type(k) == "string" and v2x == true then out[k] = true end
            end
        elseif type(sel) == "string" and sel ~= "" then
            out[sel] = true
        end
        return out
    end
    local function crateSelectedList()
        local l = {}
        for k, v2x in pairs(crateState.selected) do if v2x then l[#l+1] = k end end
