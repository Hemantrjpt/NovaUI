    local function readMasteryData()
        local data
        for _ = 1, 3 do
            local ok, res = pcall(fn)
            if ok and type(res) == "table" and res.Slots then
                data = res
                break
            end
            local ok2, res2 = pcall(get.InvokeServer, get, "Data", "Copy")
            if ok2 and type(res2) == "table" and res2.Slots then
                data = res2
                break
            end
            task.wait(0.3)
        end
        if type(data) ~= "table" then return nil end
        local slot = data.Current_Slot or localPlayer:GetAttribute("Slot")
        local s = slot and data.Slots and data.Slots[slot]
        if not s then return nil end
        local sk = s.Skills
        local hb = sk and sk.Hotbar
        local sh = sk and sk.Shifter

        local shift
        local eject, toss = {}, {}
        if type(hb) == "table" then
            for i = 1, 5 do if tostring(hb[i]) == "999" then shift = i; break end end
        end
        if type(sh) == "table" then
            for i = 1, 5 do
                local id = tostring(sh[i])
                if id == "200" or id == "300" or id == "400" or id == "500" then eject[tostring(i)] = true end
                if id == "301" then toss[tostring(i)] = true end
            end
        end

        local humanSkills = {}
        if type(hb) == "table" then
            for i = 1, 5 do
                local id = tostring(hb[i] or "")
                if id ~= "" and id ~= "999" and id ~= "nil" then humanSkills[#humanSkills+1] = i end
            end
        end

        return { shiftSlot = shift, ejectSlots = eject, tossSlots = toss, humanSkillSlots = humanSkills }
    end

