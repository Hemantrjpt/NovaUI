    local titanMasteryStop = false
    local function titanMasteryLoop()
        local function masteryMove(part, dist)
            if localPlayer:GetAttribute("Cutscene") then return end
            local char = localPlayer.Character
            local hrp2 = char and char:FindFirstChild("HumanoidRootPart")
            if not (hrp2 and part) then return end
            local mode = getgenv().AutoFarmConfig.MovementMode or "Hover"
            local target = part.Position + Vector3.new(0, 10, dist)
            if mode == "Teleport" then
                hrp2.AssemblyLinearVelocity = Vector3.zero
                hrp2.CFrame = CFrame.new(target)
            else
                local diff = target - hrp2.Position
                if diff.Magnitude > 0.5 then
                    hrp2.AssemblyLinearVelocity = diff.Unit
                        * math.min(getgenv().AutoFarmConfig.Speed or 400, diff.Magnitude * 14)
                else
                    hrp2.AssemblyLinearVelocity = Vector3.zero
                end
            end
        end
        while not titanMasteryStop and getgenv().TitanMasteryFarm do
            task.wait(0.3)
            if not flag4 then masterySetStatus("Not in game"); continue end
            if workspace:GetAttribute("Rewarded") or workspace:GetAttribute("Force_End") then continue end

            local mdata = readMasteryData()
            if not mdata then masterySetStatus("Data read failed"); continue end
            TitanMastery.shiftSlot       = mdata.shiftSlot
            TitanMastery.ejectSlots      = mdata.ejectSlots
            TitanMastery.tossSlots       = mdata.tossSlots
            TitanMastery.humanSkillSlots = mdata.humanSkillSlots

            local shifting = localPlayer:GetAttribute("Shifting") == true
            local bar      = localPlayer:GetAttribute("Bar") or 0
            local maxBar   = localPlayer:GetAttribute("Max_Bar") or 100
            local ts = tick()

            if shifting ~= TitanMastery.titanShifted then
                TitanMastery.titanShifted = shifting
                if shifting then
                    TitanMastery.skillRotIdx    = 1
                    TitanMastery.shiftAnimUntil = ts + 2.5
                    masterySetStatus("Shifted — waiting animation")
                else
                    masterySetStatus("Back to human — charging")
                end
            end

            if shifting then
                local cfg2 = getgenv().TitanMasteryConfig
                if (cfg2.Mode == "Punching" or cfg2.Mode == "Both")
                    and ts >= TitanMastery.shiftAnimUntil
                    and ts - TitanMastery.lastPunchTick > 1
                    and not localPlayer:GetAttribute("Cutscene") then
                    local char = localPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local target = v11(hrp)
                        if target and target:FindFirstChild("HumanoidRootPart")
                            and not target:GetAttribute("Killed")
                            and not target:GetAttribute("Dead")
                            and target:GetAttribute("State") ~= "Roar"
                            and target:GetAttribute("State") ~= "Berserk_Mode"
                            and not target:GetAttribute("Shifter") then
                            local adornee = target:FindFirstChild("Marker")
                                and target.Marker.Adornee ~= nil
                                and target.Marker.Adornee
                                or (target.Hitboxes and target.Hitboxes.Hit
                                    and target.Hitboxes.Hit.Nape)
                            if adornee then
                                TitanMastery.lastPunchTick = ts
                                masterySetStatus("Punching " .. target.Name)
                                if cfg2.Hover ~= false then
                                    masteryMove(adornee, math.min(tonumber(cfg2.Distance) or 80, 120))
                                end
                                post:FireServer("Attacks", "Slash", true)
                                post:FireServer("Hitboxes", "Register",
                                    adornee, nil, nil, TitanMastery.punchCombo)
                                TitanMastery.punchCombo += 1
                                if TitanMastery.punchCombo > 4 then
                                    TitanMastery.punchCombo = 1
                                end
                            end
                        end
                    end
                end

                local mcfg = getgenv().TitanMasteryConfig
                if (mcfg.Mode == "Skills" or mcfg.Mode == "Both")
                    and ts >= TitanMastery.shiftAnimUntil and ts - TitanMastery.lastSkillTick > 0.6 then
                    TitanMastery.lastSkillTick = ts
                    local idx = TitanMastery.skillRotIdx
                    for _ = 1, 5 do
                        if not TitanMastery.ejectSlots[tostring(idx)] then break end
                        idx = (idx % 5) + 1
                    end
                    if TitanMastery.tossSlots[tostring(idx)] then
                        local char = localPlayer.Character
                        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
                        local pos  = hrp and (hrp.Position + hrp.CFrame.LookVector * 80) or nil
                        masterySetStatus("Titan Toss slot " .. idx)
                        fireSkillSlot(idx, pos, false)
                        for _ = 1, 4 do
                            task.wait(0.5)
                            if localPlayer:GetAttribute("Target") == nil then break end
                            fireSkillSlot(idx, pos, false)
                        end
                    elseif not TitanMastery.ejectSlots[tostring(idx)] then
                        masterySetStatus(string.format("Skill %d (bar %.0f/%d)", idx, bar, maxBar))
                        fireSkillSlot(idx)
                    end
                    TitanMastery.skillRotIdx = (idx % 5) + 1
                end
            elseif maxBar <= bar and ts - TitanMastery.lastShiftTick > 2 then
                TitanMastery.lastShiftTick = ts
                local slot = TitanMastery.shiftSlot
                if slot then
                    masterySetStatus(string.format("Bar full (%.0f/%d) — shifting slot %d", bar, maxBar, slot))
                    fireSkillSlot(slot)
                else
                    masterySetStatus("Bar full but shift slot not found")
                end
            end
        end
    end

