    function Thunder.readProgress()
        local out, wanted = {}, {}
        for _, q in ipairs(Thunder.QUESTS) do
            for _, tag in ipairs(q.tags) do wanted[tag] = true end
        end
        local iface = playerGui:FindFirstChild("Interface")
        if not iface then return out end
        for _, d in ipairs(iface:GetDescendants()) do
            if d.Name == "Tag" and d:IsA("TextLabel") then
                local upper = tostring(d.Text):upper()
                if wanted[upper] then
                    local parent = d.Parent
                    local bar = parent and parent:FindFirstChild("Bar") and parent.Bar:FindFirstChild("Amount")
                    local cur, tgt
                    if bar and bar:IsA("TextLabel") then
                        cur, tgt = bar.Text:match("([%d%.]+)%s*/%s*([%d%.]+)")
                    end
                    out[upper] = { current = tonumber(cur) or 0, target = tonumber(tgt) or 0 }
                end
            end
        end
        return out
    end
    function Thunder.missionDone(quest, progress)
        for _, tag in ipairs(quest.tags) do
            local p = progress[tag]
            if not p then return false end
            if not (p.target > 0 and p.current >= p.target) then return false end
        end
        return true
    end
    local function thunderFirstHitbox(inst)
        if not inst then return nil end
        local ok, p = pcall(function()
            local hb = inst:FindFirstChild("Hitbox", true)
            if hb and hb:IsA("BasePart") then return hb end
            if inst:IsA("BasePart") then return inst end
            if inst:IsA("Model") and inst.PrimaryPart then return inst.PrimaryPart end
            return inst:FindFirstChildWhichIsA("BasePart", true)
        end)
        return ok and p or nil
    end
    function Thunder.crateTarget()
        local Unc = workspace:FindFirstChild("Unclimbable")
        for _, root in ipairs({ Unc and Unc:FindFirstChild("Objective"), Unc, workspace }) do
            if root then
                for _, c in ipairs(root:GetChildren()) do
                    if c.Name:lower():match("^supplies_c") then
                        local p = thunderFirstHitbox(c)
                        if p then return c, p end
                    end
                end
            end
        end
        return nil, nil
    end
    function Thunder.activeTower()
        local ok, tagged = pcall(function() return game:GetService("CollectionService"):GetTagged("TS_Towers") end)
        if not ok or not tagged then return nil end
        local best
        for _, vv in ipairs(tagged) do
            if vv.Parent and vv.Name:lower():match("^watchtower_(%d+)") then
                local p = thunderFirstHitbox(vv)
                if p then
                    local n = tonumber(vv.Name:match("_(%d+)$")) or 0
                    if not best or n < best.n then best = { inst = vv, part = p, n = n } end
                end
            end
        end
        return best
    end
    function Thunder.escortTarget()
        local Unc = workspace:FindFirstChild("Unclimbable")
        for _, root in ipairs({ Unc and Unc:FindFirstChild("Objective"), Unc, workspace }) do
            if root then
                for _, c in ipairs(root:GetChildren()) do
                    if c.Name:lower():match("^escort$") or (c:FindFirstChild("Collider") and c:FindFirstChild("Cart")) then
                        local col = c:FindFirstChild("Collider", true)
                        if col and col:IsA("BasePart") then return c, col end
                    end
                end
            end
        end
        return nil, nil
    end

    local thunderNavRunning = false
    local thunderNavStop = false

    local function thunderNav()
        thunderNavRunning = true
        local seenSupply = {}
        local mode = "PICKUP"
        local carryInst
        local lastTowerN
        while not thunderNavStop and flag4 do
            task.wait(0.1)
            if not localPlayer.Character or not localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                continue
            end
            local hrp = localPlayer.Character.HumanoidRootPart
            local tower = Thunder.activeTower()
            local escortInst, escortPart = Thunder.escortTarget()

            -- FIX: use HoverFunc (the actual hover/teleport mover) — v21 in this
            -- scope is performanceMode, which silently broke all Thunder nav
            if tower then
                if lastTowerN ~= tower.n then
                    lastTowerN = tower.n
                    thunderSetStatus("Towers: WatchTower_" .. tostring(tower.n))
                end
                local size = tower.part.Size.Z * 0.5
                local h = math.max(8, size * 0.92)
                local above = tower.part.Position + Vector3.new(0, h, 0)
                HoverFunc(tower.part, above - tower.part.Position)
            elseif escortPart then
                HoverFunc(escortPart, Vector3.new(0, getgenv().AutoFarmConfig.FloatHeight, 0))
                thunderSetStatus("Escort: following cart")
            else
                local bestInst, bestPart, bestD
                local Unc = workspace:FindFirstChild("Unclimbable")
                for _, root in ipairs({ Unc and Unc:FindFirstChild("Objective"), Unc, workspace }) do
                    if root then
                        for _, c in ipairs(root:GetChildren()) do
                            if c.Name:lower():match("^thunderspear_supplies") and not seenSupply[c] and c.Parent then
                                local p = thunderFirstHitbox(c)
                                if p then
                                    local d = (hrp.Position - p.Position).Magnitude
                                    if not bestD or d < bestD then bestInst, bestPart, bestD = c, p, d end
                                end
                            end
                        end
                    end
                end
                if bestInst and mode == "PICKUP" then
                    carryInst = bestInst
                    HoverFunc(bestPart, Vector3.new(0, 0, 0))
                    if (hrp.Position - bestPart.Position).Magnitude <= 12 then
                        mode = "DROPOFF"
                        thunderSetStatus("Carrying: " .. bestInst.Name)
                    end
                elseif mode == "DROPOFF" then
                    local crateInst, cratePart = Thunder.crateTarget()
                    if cratePart then
                        HoverFunc(cratePart, Vector3.new(0, 0, 0))
                        if (hrp.Position - cratePart.Position).Magnitude <= 12 then
                            seenSupply[carryInst] = true
                            mode = "PICKUP"
                            carryInst = nil
                            thunderSetStatus("Delivered")
                        end
                    end
                else
                    local nearest = v11(hrp)
                    if nearest and nearest:FindFirstChild("HumanoidRootPart") then
                        HoverFunc(nearest.HumanoidRootPart, Vector3.new(0, getgenv().AutoFarmConfig.FloatHeight, 0))
                        thunderSetStatus("Combat farm")
                    else
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end
        end
        thunderNavRunning = false
    end

