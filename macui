        local function rigSpearsUsable()
            local char = localPlayer.Character
            local rig = char
                and (char:FindFirstChild("Rig_" .. localPlayer.Name) or char)
            if not rig then return nil end
            local sawHolder, count = false, 0
            for _, armName in ipairs({ "LeftLowerArm", "RightLowerArm" }) do
                local arm = rig:FindFirstChild(armName)
                local holder = arm and arm:FindFirstChild("Spears")
                if holder then
                    sawHolder = true
                    for _, spear in ipairs(holder:GetChildren()) do
                        if spear:GetAttribute("Used") == nil then
                            count += 1
                        end
                    end
                end
            end
            if not sawHolder then return nil end
            return count
        end

        local function cdhwAmmoOut()
            local hud = interface:FindFirstChild("HUD")
            if not hud then return false end
            local top2 = hud:FindFirstChild("Main")
            top2 = top2 and top2:FindFirstChild("Top")
            local frame2 = top2 and top2:FindFirstChild("7")
            if not frame2 then return false end
            if localPlayer:GetAttribute("Weapon") == "Spears" then
                local label = frame2:FindFirstChild("Spears")
                label = label and label:FindFirstChild("Spears")
                local ammo = label
                    and (tonumber(tostring(label.Text):match("^(%d+)")) or 0) or 0
                if ammo <= 0 then return true end
                local usable = rigSpearsUsable()
                return usable == 0
            end
            local sets = frame2:FindFirstChild("Blades")
            sets = sets and sets:FindFirstChild("Sets")
            local ammo = sets
                and (tonumber(tostring(sets.Text):match("^(%d+)")) or 0) or 0
            return ammo <= 0
        end

        local function cdhwFindRefill()
            if getgenv().THUB_FindRefill then
                local shared = getgenv().THUB_FindRefill()
                if shared then return shared end
            end
            local unclimbable = workspace:FindFirstChild("Unclimbable")
            local props = unclimbable and unclimbable:FindFirstChild("Props")
            local hq = props and props:FindFirstChild("HQ")
            if hq then
                for _, prop in ipairs(hq:GetChildren()) do
                    local fill = prop:FindFirstChild("Refill")
                    if fill and fill:IsA("BasePart") then return fill end
                end
            end
            if props then
                for _, prop in ipairs(props:GetChildren()) do
                    local fill = prop:FindFirstChild("Refill")
                    if fill and fill:IsA("BasePart") then return fill end
                end
            end
            local world = workspace:FindFirstChild("World")
            local wprops = world and world:FindFirstChild("Props")
            if wprops then
                for _, prop in ipairs(wprops:GetChildren()) do
                    local fill = prop:FindFirstChild("Refill")
                    if fill and fill:IsA("BasePart") then return fill end
                end
            end
            return nil
        end

        local function cdhwRefillTrip()
