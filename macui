    -- Rewards screen scraper
    local REWARD_KEYWORDS = {
        { "epic perk",      "EpicPerksCollected" },
        { "legendary perk", "LegendaryPerks"     },
        { "mythic perk",    "MythicPerks"        },
        { "prestige",       "PrestigeScrolls"    },
        { "serum",          "TitanSerums"        },
        { "shard",          "TitanShards"        },
        { "gold",           "GoldCollected"      },
        { "gem",            "GemsCollected"      },
        { "cane",           "CanesCollected"     },
        { "exp",            "ExpCollected"       },
    }
    local function rewardKeyFor(text)
        if not text then return nil end
        local lower = tostring(text):lower()
        if lower == "" then return nil end
        for _, pair in ipairs(REWARD_KEYWORDS) do
            if lower:find(pair[1], 1, true) then return pair[2] end
        end
        return nil
    end
    local function rewardAmountFrom(texts)
        local fallback
        for _, text in ipairs(texts) do
            local clean = tostring(text):gsub("[%+%-%s,]", "")
            if clean:match("^%d+%.?%d*$") then
                return tonumber(clean)
            end
            local num = tonumber(tostring(clean):match("%d+%.?%d*"))
            if num and not fallback then fallback = num end
        end
        return fallback
    end
    local function scrapeRewards()
        pcall(function()
            local main = rewards and rewards:FindFirstChild("Main")
            local info = main and main:FindFirstChild("Info")
            local inner = info and info:FindFirstChild("Main")
            if not inner then return end
            local bumped = {}
            for _, section in ipairs({ "Stats", "Items" }) do
                local holder = inner:FindFirstChild(section)
                if holder then
                    for _, row in ipairs(holder:GetChildren()) do
                        local texts = { tostring(row.Name) }
                        for _, d in ipairs(row:GetDescendants()) do
                            if d:IsA("TextLabel") and d.Text and d.Text ~= "" then
                                texts[#texts + 1] = tostring(d.Text)
                            end
                        end
                        local key
                        for _, text in ipairs(texts) do
                            key = rewardKeyFor(text)
                            if key then break end
                        end
                        local amount = rewardAmountFrom(texts)
                        if key then
                            bumped[key] = (bumped[key] or 0) + (amount or 1)
                        elseif section == "Items" then
                            bumped.ItemDrops = (bumped.ItemDrops or 0) + (amount or 1)
                        end
                    end
                end
            end
            for key, amt in pairs(bumped) do
                bumpStat(key, amt)
            end
            if next(bumped) then refreshStatLabels() end
        end)
    end

